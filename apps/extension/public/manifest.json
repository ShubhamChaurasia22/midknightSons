{
  "manifest_version": 3,
  "name": "Shield — Privacy & Security for AI",
  "version": "0.1.0",
  "description": "Protects sensitive data and privacy when interacting with AI platforms.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Shield",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
